    {
        "id": "fn_sanitizar_bd",
        "type": "function",
        "z": "7537b1f775c84d83",
        "name": "Sanitizar e INSERT Parametrizado",
        "func": "let data = msg.payload;\n\n// 1. Descartar si el sensor reportó código de error (Capa 1.3 y Capa 2.3)\nif (data.error && data.error !== 0) {\n    node.warn(`Lectura descartada: sensor ${data.sensor} con error ${data.error}`);\n    return null;\n}\n\nlet valor = parseFloat(data.valor);\nif (isNaN(valor)) return null;\n\n// 2. Sentencia INSERT parametrizada (Capa 3.3)\nmsg.topic = \"INSERT INTO telemetria (sensor, valor) VALUES (?, ?);\";\nmsg.payload = [data.sensor, valor];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 160,
        "wires": [
            [
                "mysql_insert"
            ]
        ]
    },
