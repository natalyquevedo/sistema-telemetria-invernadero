    {
        "id": "fn_despachador",
        "type": "function",
        "z": "7537b1f775c84d83",
        "name": "Despachador a Dashboard y Alertas",
        "func": "let data = msg.payload;\nlet hora = new Date().toLocaleTimeString();\n\n// Salida 4: Alerta si el hardware reporta error\nif (data.error && data.error !== 0) {\n    let desc = data.error === 101 ? \"Falla sensor DHT11\" : \"Sensor de suelo desconectado\";\n    return [null, null, null, { payload: `[${hora}] ❌ ERROR: ${desc} (Código: ${data.error})` }];\n}\n\nlet val = parseFloat(data.valor);\nif (isNaN(val)) return null;\nlet out = { payload: val };\n\n// Salida 1: Temperatura\nif (data.sensor === \"temperatura\") {\n    return [out, null, null, null];\n}\n// Salida 2: Humedad Aire\nif (data.sensor === \"humedad_aire\") {\n    return [null, out, null, null];\n}\n// Salida 3: Humedad Suelo\nif (data.sensor === \"humedad_suelo\") {\n    return [null, null, out, null];\n}\n\nreturn null;",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 320,
        "wires": [
            [
                "ui_gauge_temp",
                "ui_chart_temp",
                "fn_alerta_temp"
            ],
            [
                "ui_gauge_hum_aire",
                "ui_chart_hum_aire",
                "fn_alerta_hum"
            ],
            [
                "ui_gauge_hum_suelo"
            ],
            [
                "ui_toast_alerta",
                "ui_text_alerta"
            ]
        ]
    },
    {
        "id": "fn_alerta_temp",
        "type": "function",
        "z": "7537b1f775c84d83",
        "name": "Validar Alerta Temp (>28°C)",
        "func": "let val = msg.payload;\nif (val > 28) {\n    let hora = new Date().toLocaleTimeString();\n    return { payload: `[${hora}] ⚠️ ALERTA: Temp crítica alta: ${val.toFixed(1)}°C (>28°C)` };\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 200,
        "wires": [
            [
                "ui_toast_alerta",
                "ui_text_alerta"
            ]
        ]
    },
    {
        "id": "fn_alerta_hum",
        "type": "function",
        "z": "7537b1f775c84d83",
        "name": "Validar Alerta Hum (30%-50%)",
        "func": "let val = msg.payload;\nif (val < 30 || val > 50) {\n    let hora = new Date().toLocaleTimeString();\n    let estado = val < 30 ? \"Baja\" : \"Alta\";\n    return { payload: `[${hora}] ⚠️ ALERTA: Humedad ${estado}: ${val.toFixed(1)}% (Óptimo: 30%-50%)` };\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 300,
        "wires": [
